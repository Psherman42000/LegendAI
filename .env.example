# ═══════════════════════════════════════════
# OBRIGATÓRIO — Transcrição
# ═══════════════════════════════════════════

WHISPER_API_URL=http://localhost:8000
OPENAI_API_KEY=sk-...    # Fallback quando Whisper local offline

# ═══════════════════════════════════════════
# OBRIGATÓRIO — FFmpeg (extração áudio + queima legenda)
# ═══════════════════════════════════════════

FFMPEG_PATH=C:\tools\ffmpeg\ffmpeg-8.1-essentials_build\bin\ffmpeg.exe

# ═══════════════════════════════════════════
# OBRIGATÓRIO — Banco, Fila, Auth
# ═══════════════════════════════════════════

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legendaai"
REDIS_URL="redis://localhost:6379"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="(rode: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\")"

GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ═══════════════════════════════════════════
# OBRIGATÓRIO — Cloudflare R2
# ═══════════════════════════════════════════

R2_ACCOUNT_ID="(id da conta)"
R2_ACCESS_KEY_ID="(token access key)"
R2_SECRET_ACCESS_KEY="(token secret)"
R2_BUCKET_NAME="legendaai-videos"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ═══════════════════════════════════════════
# OPCIONAL — Mercado Pago / Email
# ═══════════════════════════════════════════

# MP_ACCESS_TOKEN=
# RESEND_API_KEY=

# ═══════════════════════════════════════════
# Worker
# ═══════════════════════════════════════════

WORKER_SECRET="shared-secret-between-api-and-worker"

# ═══════════════════════════════════════════
# App
# ═══════════════════════════════════════════

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ═══════════════════════════════════════════
# AI Subtitle Correction
# ═══════════════════════════════════════════

# AI Subtitle Correction Strategy (used when user toggles "Corrigir pontuação com IA")
# Options: local_llm (best local quality), openai (cloud)
AI_CORRECTION_STRATEGY=local_llm

# Local LLM Configuration (only used if AI_CORRECTION_STRATEGY=local_llm)
# Recommended: Qwen/Qwen2.5-1.5B-Instruct-GGUF or meta-llama/Llama-3.2-1B-Instruct-GGUF
LOCAL_LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
