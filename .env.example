# ═══════════════════════════════════════════
# OBRIGATÓRIO — Transcrição
# ═══════════════════════════════════════════

WHISPER_API_URL=http://localhost:8000
OPENAI_API_KEY=sk-...    # Fallback quando Whisper local offline

# ═══════════════════════════════════════════
# OBRIGATÓRIO — FFmpeg (extração áudio + queima legenda)
# ═══════════════════════════════════════════

FFMPEG_PATH=C:\tools\ffmpeg\ffmpeg-8.1-essentials_build\bin\ffmpeg.exe

# ═══════════════════════════════════════════
# OBRIGATÓRIO — Banco, Fila, Auth
# ═══════════════════════════════════════════

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legendaai"
REDIS_URL="redis://localhost:6379"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="(rode: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\")"

GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ═══════════════════════════════════════════
# OBRIGATÓRIO — Cloudflare R2
# ═══════════════════════════════════════════

R2_ACCOUNT_ID="(id da conta)"
R2_ACCESS_KEY_ID="(token access key)"
R2_SECRET_ACCESS_KEY="(token secret)"
R2_BUCKET_NAME="legendaai-videos"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ═══════════════════════════════════════════
# OPCIONAL — Mercado Pago / Email
# ═══════════════════════════════════════════

# MP_ACCESS_TOKEN=
# RESEND_API_KEY=

# ═══════════════════════════════════════════
# Worker
# ═══════════════════════════════════════════

WORKER_SECRET="shared-secret-between-api-and-worker"

# ═══════════════════════════════════════════
# App
# ═══════════════════════════════════════════

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ═══════════════════════════════════════════
# AI Subtitle Correction
# ═══════════════════════════════════════════

# OpenCode SDK Configuration
OPENCODE_BASE_URL="http://127.0.0.1:4096"
OPENCODE_MODEL="opencode-go/deepseek-v4-flash"
